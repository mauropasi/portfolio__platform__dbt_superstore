{
  "name": "portfolio__platform__dbt_superstore",
  "image": "ghcr.io/mauropasi/portfolio__platform__dbt_runtime:main",
  "runArgs": [
    "--platform=linux/amd64"
  ],
  "remoteUser": "vscode",
  "containerEnv": {
    "DBT_TYPE": "duckdb",
    "DBT_DUCKDB_PATH": "dev.duckdb"
  },
  "postCreateCommand": "mkdir -p ~/.dbt && echo 'default:\n  target: local\n  outputs:\n    local:\n      type: duckdb\n      path: dev.duckdb\n      threads: 4' > ~/.dbt/profiles.yml",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "dbt.profilesDir": "/home/vscode/.dbt"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "innoverio.vscode-dbt-power-user",
        "Dorotiy.sqlfluff"
      ]
    }
  },
  "forwardPorts": [8080]
}
